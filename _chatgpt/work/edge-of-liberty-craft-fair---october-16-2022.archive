}</script><script type="text/javascript">window._BLOG_DATA={"head":{"title":"Edge of Liberty Craft Fair - October 16, 2022","meta":[{"type":"property","key":"og:title","value":"Edge of Liberty Craft Fair - October 16, 2022"},{"type":"property","key":"og:description","value":"This is our last craft fair of the 2022 season and we're excited to share the bounty of our final harvest with you.  Winter is coming, and this may be one of the last truly beautiful weekends to enjoy outdoors.  We know ..."},{"type":"property","key":"og:image","value":"https://img1.wsimg.com/isteam/ip/5c0d4bf0-4792-4184-8c0d-5227a17a1b3a/20220619_124035-COLLAGE.jpg"},{"type":"property","key":"og:image:height","value":"600"},{"type":"property","key":"og:image:width","value":"315"},{"type":"name","key":"twitter:card","value":"summary"},{"type":"name","key":"twitter:title","value":"Edge of Liberty Craft Fair - October 16, 2022"},{"type":"name","key":"twitter:description","value":"This is our last craft fair of the 2022 season and we're excited to share the bounty of our final harvest with you.  Winter is coming, and this may be one of the last truly beautiful weekends to enjoy outdoors.  We know ..."},{"type":"name","key":"twitter:image","value":"https://img1.wsimg.com/isteam/ip/5c0d4bf0-4792-4184-8c0d-5227a17a1b3a/20220619_124035-COLLAGE.jpg"},{"type":"name","key":"twitter:image:alt","value":"Edge of Liberty Craft Fair - October 16, 2022"},{"type":"property","key":"og:url","value":"https://edge-of-liberty.com/blog/f/edge-of-liberty-craft-fair---october-16-2022"}]},"post":{"blogId":"160bab42-5172-42c8-8ac2-472bbc890000","postId":"5554bf9f-3687-4be4-b7d0-e127523fdddb","hideCommenting":true,"title":"Edge of Liberty Craft Fair - October 16, 2022","date":"2022-09-20T09:37:50.591Z","content":"This is our last craft fair of the 2022 season and we're excited to share the bounty of our final harvest with you.  Winter is coming, and this may be one of the last truly beautiful weekends to enjoy outdoors.  We know ...","slug":"edge-of-liberty-craft-fair---october-16-2022","featuredImage":"https://img1.wsimg.com/isteam/ip/5c0d4bf0-4792-4184-8c0d-5227a17a1b3a/20220619_124035-COLLAGE.jpg","categories":["Events","General"],"featureFlags":{"commenting":false,"resellerRssToEmail":false,"rssToEmail":false,"showCategories":true,"showSocial":true,"socialPlatforms":[]},"publishedDate":"2022-10-13T18:54:29.539Z","fullContent":"{\"blocks\":[{\"key\":\"b7e47\",\"text\":\"This is our last craft fair of the 2022 season and we're excited to share the bounty of our final harvest with you.  Winter is coming, and this may be one of the last truly beautiful weekends to enjoy outdoors.  We know it's not even Halloween yet, but our fair is just 70 days before Christmas and it really is incredible how quickly those days pass with so many holidays to celebrate and decorate.  If you're looking for decor, self-pampering items, and beautiful handmade gifts from home-based artisans, our craft fair vendors will have you covered at our last craft fair of the season.  \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"cod2s\",\"text\":\"At this month's fair we will have an enormous pumpkin bounce house for the kids courtesy of Cooper’s Party Rentals LLC! \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":92,\"length\":26,\"key\":0}],\"data\":{}},{\"key\":\"f0nrp\",\"text\":\"The Lunch Box food truck will be joining us as well, so you can make an entire day of it and enjoy a lovely walk through nature, do some shopping, have some lunch, watch the kids and grandkids enjoy the bounce house, and grab some fresh picked goodness from our farm stand.  \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":18,\"key\":1}],\"data\":{}},{\"key\":\"3r29s\",\"text\":\"We hope you will join us and be part of our community!\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"97k95\",\"text\":\"Read all the details about our vendors and their amazing products below.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"3onuf\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":2}],\"data\":{}},{\"key\":\"6n62f\",\"text\":\"Where are you? (click for map) \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":13,\"style\":\"UNDERLINE\"}],\"entityRanges\":[{\"offset\":0,\"length\":13,\"key\":3}],\"data\":{}},{\"key\":\"22f04\",\"text\":\"We're conveniently located on old 49 (Calumet) a mile north of Valparaiso and a mile south of the drive-in theater, right on the edge of Liberty Township.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"hrjs\",\"text\":\"What crafts will be available? (click for gallery) \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":29,\"style\":\"UNDERLINE\"}],\"entityRanges\":[{\"offset\":0,\"length\":29,\"key\":4}],\"data\":{}},{\"key\":\"6p45u\",\"text\":\"Committed vendors for this event and information about their products are detailed below with links to their personal pages. All vendors either accept credit cards personally, or can accept payments through our \\\"Pay With Paypal\\\" button on our home page, but would prefer cash.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":264,\"length\":11,\"style\":\"ITALIC\"}],\"entityRanges\":[{\"offset\":243,\"length\":9,\"key\":5}],\"data\":{}},{\"key\":\"8jafd\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":6}],\"data\":{}},{\"key\":\"cjjb8\",\"text\":\"Our Vendors For October 16\",\"type\":\"header-four\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":26,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"6ngns\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":7}],\"data\":{}},{\"key\":\"eo764\",\"text\":\"The Lunch Box\",\"type\":\"header-four\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":13,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":0,\"length\":13,\"key\":8}],\"data\":{}},{\"key\":\"2eeaf\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":9}],\"data\":{}},{\"key\":\"99d13\",\"text\":\"Steak, Pork, or Breakfast Burritos \",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"akd1v\",\"text\":\"Enchiladas\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"ui3s\",\"text\":\"Cuban Fly\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"d4p44\",\"text\":\"Cheeseburgers\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"7h3cr\",\"text\":\"Nachos, Churros, Sugar dots\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"da1ci\",\"text\":\"...and more\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"505h9\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":10}],\"data\":{}},{\"key\":\"bokl8\",\"text\":\"Cooper’s Party Rentals LLC\",\"type\":\"header-four\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":26,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":0,\"length\":26,\"key\":0}],\"data\":{}},{\"key\":\"3jr86\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineSty
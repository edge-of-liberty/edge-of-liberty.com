eRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":53}],\"data\":{}},{\"key\":\"njl8\",\"text\":\"Handcrafted Wooden items\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"e3h2h\",\"text\":\"Woodburned art\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"1db8v\",\"text\":\"Turned pens\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"fufgu\",\"text\":\"keychains\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"6ce8n\",\"text\":\"bottle stoppers\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"46jeb\",\"text\":\"Intarsia art\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"c400p\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":54}],\"data\":{}},{\"key\":\"72h5j\",\"text\":\"Your Small Business Listed Here\",\"type\":\"header-four\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":31,\"style\":\"ITALIC\"},{\"offset\":0,\"length\":31,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"42c9n\",\"text\":\"📷Edit Image\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":55}],\"data\":{}},{\"key\":\"2kuqk\",\"text\":\"We're looking for home-based vendors selling products they make themselves who live in or near Porter county. Fill out this form to sign up! Reminder that the New Law went into effect on July 1 so we can now accept applications from those who sell non-potentially hazardous foods with a copy of food handler certification on file.\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":119,\"length\":9,\"key\":56},{\"offset\":159,\"length\":34,\"key\":57}],\"data\":{}},{\"key\":\"churf\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":58}],\"data\":{}},{\"key\":\"ano4m\",\"text\":\"The Edge of Liberty\",\"type\":\"header-four\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":19,\"style\":\"UNDERLINE\"},{\"offset\":0,\"length\":19,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":0,\"length\":19,\"key\":59}],\"data\":{}},{\"key\":\"b2k73\",\"text\":\"📷Edit Image\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":60}],\"data\":{}},{\"key\":\"e9ng3\",\"text\":\"Fresh cut herbs from our pollinator garden\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"cs91j\",\"text\":\"Fresh organic produce from our market garden\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"6t200\",\"text\":\"Click here for our Fresh Pick Menu updated weekly\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":49,\"style\":\"UNDERLINE\"}],\"entityRanges\":[{\"offset\":0,\"length\":49,\"key\":61}],\"data\":{}},{\"key\":\"5m9k3\",\"text\":\"The Edge of Liberty Farm Stand will be open every Sunday from May 15 through October 16 this year! Craft fairs are part of the fun every third Sunday.\",\"type\":\"unordered-list-item\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":44,\"length\":5,\"style\":\"ITALIC\"},{\"offset\":137,\"length\":5,\"style\":\"ITALIC\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"9u6t3\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":62}],\"data\":{}},{\"key\":\"ahsaa\",\"text\":\"About The Edge of Liberty\",\"type\":\"header-four\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":25,\"style\":\"BOLD\"}],\"entityRanges\":[],\"data\":{}},{\"key\":\"9313t\",\"text\":\"📷Edit ImageThe Edge of Liberty Craft Fair\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":63}],\"data\":{}},{\"key\":\"b19t1\",\"text\":\"The Edge of Liberty is a four acre farm that we purchased because the neighborhoods surrounding it wanted to preserve the rural feeling of Liberty Township and stop it from being developed. Since it was a community effort to keep it rural, we want the community to get a chance to enjoy it...together! \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"983q5\",\"text\":\"Events and services at The Edge of Liberty are centered around creating and maintaining a sense of community and preserving that hometown rural feeling that made us all fall in love with this area. In addition to the community garden that we started last season and a weekly farm stand of produce grown in our market and pollinator gardens to help defray costs of maintaining the property, we're providing this monthly outlet for members of the community to sell their handmade goods and to give you an opportunity to share good times with friends and neighbors. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"ata2v\",\"text\":\"Help us celebrate life and create happiness! See you on Sunday, October 16!\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{\"0\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"https://www.cooperspartyrentals.com/\",\"target\":\"\"}},\"1\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"data\":{\"href\":\"https://thelunchboxonwheels.com/\",\"target\":\"\"}},\"2\":{\"type\":\"DIVIDER\",\"mutability\":\"IMMUTABLE\",\"data\":{}},\"3\":{\"type\":\"LINK\",\"m
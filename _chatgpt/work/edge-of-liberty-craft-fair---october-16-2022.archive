ntityRanges\":[],\"data\":{}},{\"key\":\"7qvkp\",\"text\":\"$1 per bag of coffee sold goes toward onetreeplanted.org. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":38,\"length\":18,\"key\":39}],\"data\":{}},{\"key\":\"9mo8c\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":40}],\"data\":{}},{\"key\":\"320ui\",\"text\":\"Iridescence\",\"type\":\"header-four\",\"depth\":0,\"inlineStyleRanges\":[{\"offset\":0,\"length\":11,\"style\":\"BOLD\"}],\"entityRanges\":[{\"offset\":0,\"length\":11,\"key\":41}],\"data\":{}},{\"key\":\"d94f3\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":42}],\"data\":{}},{\"key\":\"6a5vs\",\"text\":\"At Iridescence we make customizable pearl jewelry! You get to choose your jewelry piece first, which could be a necklace pendant, earrings, a bracelet, or a ring. And then you get to decide if you want me to open a random oyster (pearls come in a large variety of colors) or if you want a natural colored pearl (white, cream, pink, lavender) for your jewelry piece. I open the oysters right in front of you and you get to watch your pearl come out. We will set your jewelry right then and there and you get to watch the whole process before taking your pearl jewelry home that day. We even have cage necklaces where you can open an oyster at home and place your pearl in your necklace all on your own! At Iridescence, we can also make custom hand made necklaces and bracelets, perfect for special gifts or wedding jewelry! \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"fe4ee\",\"text\":\" \",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":43}],\"data\":{}},{\"key\":\"6o48q\",\"text\":\"Katie Dids Natural Products\",\"type\":\"header-four\",\"d
},{\"key\":\"erdnp\",\"text\":\"📷Edit ImageThe Edge of Liberty Craft Fair\",\"type\":\"atomic\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[{\"offset\":0,\"length\":1,\"key\":65}],\"data\":{}},{\"key\":\"2gige\",\"text\":\"The Edge of Liberty is a four acre farm that we purchased because the neighborhoods surrounding it wanted to preserve the rural feeling of Liberty Township and stop it from being developed. Since it was a community effort to keep it rural, we want the community to get a chance to enjoy it...together! \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"2e1dv\",\"text\":\"Events and services at The Edge of Liberty are centered around creating and maintaining a sense of community and preserving that hometown rural feeling that made us all fall in love with this area. In addition to the community garden that we started last season and a weekly farm stand of produce grown in our market and pollinator gardens to help defray costs of maintaining the property, we're providing this monthly outlet for members of the community to sell their handmade goods and to give you an opportunity to share good times with friends and neighbors. \",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}},{\"key\":\"fa238\",\"text\":\"Help us celebrate life and create happiness! See you on Sunday, September 18!\",\"type\":\"unstyled\",\"depth\":0,\"inlineStyleRanges\":[],\"entityRanges\":[],\"data\":{}}],\"entityMap\":{\"0\":{\"type\":\"IMAGE\",\"mutability\":\"IMMUTABLE\",\"data\":{\"src\":\"//img1.wsimg.com/isteam/ip/5c0d4bf0-4792-4184-8c0d-5227a17a1b3a/septcollage.jpeg\",\"alignment\":\"left\",\"loading\":false,\"left\":\"0%\",\"top\":\"0%\",\"width\":\"100%\",\"height\":\"100%\",\"rotation\":\"0\",\"editedAspectRatio\":\"1\",\"filter\":\"NONE\"}},\"1\":{\"type\":\"DIVIDER\",\"mutability\":\"IMMUTABLE\",\"data\":{}},\"2\":{\"type\":\"LINK\",\"mutability\":\"MUTABLE\",\"d